	        DENSE_RANK() OVER (ORDER BY total_value DESC) AS rank_value,
	        DENSE_RANK() OVER (ORDER BY orders DESC) AS rank_frequency,
	        DENSE_RANK() OVER (
	            ORDER BY
	                CASE
	                    WHEN signup_date ~ '^\d{4}-\d{2}-\d{2}$'
	                        AND last_order ~ '^\d{4}-\d{2}-\d{2}$'
